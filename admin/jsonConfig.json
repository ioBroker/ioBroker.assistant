{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_main": {
            "type": "panel",
            "label": "Settings",
            "items": {
                "_header": {
                    "type": "header",
                    "size": 2,
                    "text": "LLM assistant"
                },
                "provider": {
                    "newLine": true,
                    "type": "select",
                    "label": "Provider",
                    "options": [
                        { "label": "OpenAI", "value": "openai" },
                        { "label": "Anthropic (Claude)", "value": "anthropic" },
                        { "label": "Google Gemini", "value": "gemini" },
                        { "label": "DeepSeek", "value": "deepseek" },
                        { "label": "OpenAI-compatible (custom)", "value": "custom" }
                    ],
                    "default": "openai",
                    "sm": 12,
                    "md": 4
                },
                "credentialType": {
                    "newLine": true,
                    "type": "select",
                    "label": "Credential mode",
                    "options": [
                        { "label": "Store key in adapter", "value": "manual" },
                        { "label": "Central credential store", "value": "manager" }
                    ],
                    "default": "manual",
                    "sm": 12,
                    "md": 4
                },
                "apiKey": {
                    "type": "password",
                    "label": "API key",
                    "hidden": "data.credentialType === 'manager'",
                    "sm": 12,
                    "md": 4
                },
                "credentialIdApiKey": {
                    "type": "credential",
                    "credentialType": "ai",
                    "label": "API-key credential",
                    "hidden": "data.credentialType !== 'manager'",
                    "sm": 12,
                    "md": 4
                },
                "model": {
                    "newLine": true,
                    "type": "autocompleteSendTo",
                    "command": "getModels",
                    "jsonData": "{\"provider\":\"${data.provider}\",\"apiKey\":\"${data.apiKey}\",\"credentialType\":\"${data.credentialType}\",\"credentialId\":\"${data.credentialIdApiKey}\",\"baseUrl\":\"${data.baseUrl}\"}",
                    "alsoDependsOn": ["provider", "credentialType", "apiKey", "credentialIdApiKey", "baseUrl"],
                    "freeSolo": true,
                    "label": "Model",
                    "help": "Loaded from the provider (instance must run); you can also type a model id.",
                    "default": "gpt-4o-mini",
                    "sm": 12,
                    "md": 4
                },
                "baseUrl": {
                    "type": "text",
                    "label": "Base URL (optional)",
                    "help": "Override the endpoint, e.g. https://api.groq.com/openai/v1 for Groq. Leave empty for the provider default.",
                    "hidden": "data.provider !== 'custom'",
                    "sm": 12,
                    "md": 8
                },
                "_testConnection": {
                    "newLine": true,
                    "type": "sendTo",
                    "label": "Test connection",
                    "command": "testApiConnection",
                    "jsonData": "{\"provider\":\"${data.provider}\",\"apiKey\":\"${data.apiKey}\",\"credentialType\":\"${data.credentialType}\",\"model\":\"${data.model}\",\"baseUrl\":\"${data.baseUrl}\",\"credentialId\":\"${data.credentialIdApiKey}\"}",
                    "variant": "outlined",
                    "disabled": "data.credentialType === 'manager' ? !data.credentialIdApiKey : !data.apiKey",
                    "sm": 12,
                    "md": 4
                },
                "maxTokens": {
                    "newLine": true,
                    "type": "number",
                    "label": "Max tokens",
                    "default": 1024,
                    "min": 64,
                    "max": 8192,
                    "sm": 6,
                    "md": 2
                },
                "useLocalNlu": {
                    "type": "checkbox",
                    "label": "Answer simple commands locally (fast, offline)",
                    "help": "Try the built-in rule-based intent matching for turn on/off, dimming and status before calling the LLM.",
                    "default": true,
                    "sm": 6,
                    "md": 4
                },
                "confirmWithTone": {
                    "type": "checkbox",
                    "label": "Confirm switch commands with a beep",
                    "help": "A successful switch command is confirmed by a short tone on the satellite instead of a spoken sentence - instant, where speaking costs a text-to-speech call. Questions, errors and the text channels are unaffected.",
                    "default": false,
                    "hidden": "!data.useLocalNlu",
                    "sm": 6,
                    "md": 4
                },
                "nluAliases": {
                    "type": "table",
                    "label": "Synonym dictionary",
                    "help": "Rewrite spoken or typed variants to your device/room names before local matching, e.g. \"TV\" to \"Fernseher\". Leave the language empty to apply to all languages. Also used for the text channels.",
                    "hidden": "!data.useLocalNlu",
                    "sm": 12,
                    "md": 12,
                    "items": [
                        { "type": "text", "attr": "from", "title": "Said or typed", "width": "40%" },
                        { "type": "text", "attr": "to", "title": "Canonical term", "width": "40%" },
                        { "type": "text", "attr": "language", "title": "Language (empty = all)", "width": "20%" }
                    ]
                },
                "routines": {
                    "newLine": true,
                    "type": "table",
                    "label": "Routines",
                    "help": "A phrase that runs a list of actions: \"Gute Nacht\" switches off five things and answers once. Phrases: several separated by commas (matched anywhere in the sentence, upper/lower case and umlauts do not matter). Actions as JSON, same shape as a trigger: [{\"setState\":{\"id\":\"hm-rpc.0.ABC.1.STATE\",\"value\":false}},{\"say\":\"Schlaf gut\",\"room\":\"Schlafzimmer\"}]. Reply: what the assistant answers (leave empty to stay silent). Matched before the offline rule engine and before the LLM, so a routine is never reinterpreted.",
                    "sm": 12,
                    "md": 12,
                    "items": [
                        { "type": "text", "attr": "name", "title": "Name", "width": "15%" },
                        { "type": "text", "attr": "phrases", "title": "Phrases (comma separated)", "width": "30%" },
                        { "type": "text", "attr": "actions", "title": "Actions (JSON)", "width": "35%" },
                        { "type": "text", "attr": "reply", "title": "Reply", "width": "20%" }
                    ]
                },
                "useConversationContext": {
                    "type": "checkbox",
                    "label": "Remember the conversation (follow-up questions)",
                    "help": "Keep the last few turns per source (chat, telegram, satellite) for a few minutes so follow-ups like 'and the kitchen too' work. In-memory only.",
                    "default": true,
                    "sm": 6,
                    "md": 4
                },
                "useLongTermMemory": {
                    "type": "checkbox",
                    "label": "Long-term memory (remember facts across sessions)",
                    "help": "Lets the assistant durably remember facts you tell it (names, preferences, where things are) and use them in later conversations. Stored in the memory.* states; the LLM gets remember/forget tools.",
                    "default": true,
                    "sm": 6,
                    "md": 4
                },
                "weatherInstance": {
                    "newLine": true,
                    "type": "selectSendTo",
                    "command": "getWeatherInstances",
                    "label": "Weather source",
                    "help": "Pick an installed weather adapter to answer weather questions from (Open-Meteo, Weather Underground, OpenWeatherMap are fully understood; others are read best-effort). Start that adapter once so its data/locations appear here.",
                    "sm": 12,
                    "md": 6
                },
                "presence": {
                    "newLine": true,
                    "type": "table",
                    "label": "Presence",
                    "help": "Which states tell the assistant who is at home - one row per person. Any state works: the residents adapter, a phone ping like ping.0.phone-denis.alive, a router client state or your own flag. Kind: empty or person, guest, pet (a pet never makes the house occupied). Home value: leave empty for the usual forms (true, 1, \"home\", \"anwesend\"), or enter the exact value that means at home. Used to tell the LLM who is around, to hold back announcements to an empty house (notify with onlyWhenHome) and as a trigger source via presence.anyoneHome.",
                    "sm": 12,
                    "md": 12,
                    "items": [
                        { "type": "text", "attr": "id", "title": "State id", "width": "45%" },
                        { "type": "text", "attr": "name", "title": "Name", "width": "25%" },
                        { "type": "text", "attr": "kind", "title": "Kind (person/guest/pet)", "width": "15%" },
                        { "type": "text", "attr": "homeValue", "title": "Home value (empty = auto)", "width": "15%" }
                    ]
                },
                "timerAnnounce": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Announce when a timer expires",
                    "help": "Speak an announcement on the satellite a countdown timer was set from (or on all satellites) when it runs out. Timers are always mirrored into the timers.* states for scripts and visualization.",
                    "default": true,
                    "sm": 6,
                    "md": 4
                },
                "alarmAnnounce": {
                    "type": "checkbox",
                    "label": "Announce when an alarm goes off",
                    "help": "Speak an announcement when an alarm at a fixed clock time fires. Alarms are always mirrored into the alarms.* states for scripts and visualization.",
                    "default": true,
                    "sm": 6,
                    "md": 4
                },
                "notifyRephrase": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Reword system notifications",
                    "help": "Spoken system notifications (notify.text / the ioBroker notification manager) are reworded by the LLM into one natural sentence first - their raw texts are written for a log viewer. Costs one small LLM call per notification; the original text is spoken if it fails. Urgent ones (notify.alert) are announced even when Do-Not-Disturb is on.",
                    "default": true,
                    "sm": 6,
                    "md": 4
                },
                "_soundsHint": {
                    "newLine": true,
                    "type": "staticText",
                    "text": "Two default sounds (timer.wav, alarm.wav) are preinstalled — pick one below or upload your own mp3/wav. The selected sound plays before the spoken announcement. Needs ffmpeg on the host and at least one satellite.",
                    "sm": 12,
                    "md": 12
                },
                "ringSeconds": {
                    "newLine": true,
                    "type": "number",
                    "label": "Ring duration (seconds)",
                    "help": "A fired timer/alarm keeps ringing (looping the sound) for up to this long, or until you say 'stop'/'halt'/'aufhören'/'cancel' (or write the stopRinging state). 0 = play the sound once.",
                    "default": 60,
                    "min": 0,
                    "max": 600,
                    "sm": 6,
                    "md": 3
                },
                "timerSound": {
                    "newLine": true,
                    "type": "fileSelector",
                    "objectID": "assistant.%INSTANCE%",
                    "upload": "sounds",
                    "pattern": "sounds/*",
                    "fileTypes": "audio",
                    "delete": true,
                    "refresh": true,
                    "maxSize": 5242880,
                    "label": "Timer sound (mp3/wav, optional)",
                    "sm": 12,
                    "md": 5
                },
                "_playTimerSound": {
                    "type": "sendTo",
                    "command": "playSound",
                    "label": "Play",
                    "variant": "outlined",
                    "jsonData": "{\"name\":\"${data.timerSound}\"}",
                    "disabled": "!data.timerSound",
                    "sm": 6,
                    "md": 2
                },
                "alarmSound": {
                    "newLine": true,
                    "type": "fileSelector",
                    "objectID": "assistant.%INSTANCE%",
                    "upload": "sounds",
                    "pattern": "sounds/*",
                    "fileTypes": "audio",
                    "delete": true,
                    "refresh": true,
                    "maxSize": 5242880,
                    "label": "Alarm sound (mp3/wav, optional)",
                    "sm": 12,
                    "md": 5
                },
                "_playAlarmSound": {
                    "type": "sendTo",
                    "command": "playSound",
                    "label": "Play",
                    "variant": "outlined",
                    "jsonData": "{\"name\":\"${data.alarmSound}\"}",
                    "disabled": "!data.alarmSound",
                    "sm": 6,
                    "md": 2
                },
                "useLocalLlm": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Use a local LLM before the cloud (installed on demand)",
                    "help": "Runs a small local model (node-llama-cpp) for general questions; escalates to the cloud LLM when it needs live device data. Install it with the button below.",
                    "default": false,
                    "sm": 12,
                    "md": 6
                },
                "localLlmModelUrl": {
                    "type": "text",
                    "label": "Local model URL (GGUF, optional)",
                    "help": "Direct URL of a GGUF model. Leave empty for the default (Qwen2.5-1.5B-Instruct). Small models recommended on Raspberry Pi / arm64.",
                    "hidden": "!data.useLocalLlm",
                    "sm": 12,
                    "md": 6
                },
                "_installLocalLlm": {
                    "newLine": true,
                    "type": "sendTo",
                    "label": "Install local model",
                    "command": "installLocalLlm",
                    "variant": "outlined",
                    "hidden": "!data.useLocalLlm",
                    "showProcess": true,
                    "timeout": 600000,
                    "help": "Downloads the engine and model (several hundred MB). Progress is shown below.",
                    "sm": 12,
                    "md": 4
                },
                "_localLlmProgress": {
                    "newLine": true,
                    "type": "custom",
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "ConfigCustomAssistant/Components/LocalLlmProgress",
                    "bundlerType": "module",
                    "guiApi": 2,
                    "hidden": "!data.useLocalLlm",
                    "sm": 12,
                    "md": 8
                },
                "_accessHeader": {
                    "newLine": true,
                    "type": "header",
                    "size": 2,
                    "text": "Access / permissions"
                },
                "readObjects": {
                    "newLine": true,
                    "type": "select",
                    "label": "Object read access",
                    "options": [
                        { "label": "Only devices, rooms, functions", "value": "devices" },
                        { "label": "Any object (get_object/search_objects)", "value": "all" }
                    ],
                    "default": "devices",
                    "sm": 12,
                    "md": 4
                },
                "allowWriteStates": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Allow writing states (control devices)",
                    "default": true,
                    "sm": 6,
                    "md": 3
                },
                "verifyWrites": {
                    "type": "checkbox",
                    "label": "Verify device feedback",
                    "help": "After a switch command, wait up to 2 seconds for the device to acknowledge the new value (ack:true) and report \"did not respond\" if it never does. Leave this off for devices that never acknowledge (MQTT, scripts, 0_userdata) - every command would look failed.",
                    "default": false,
                    "hidden": "!data.allowWriteStates",
                    "sm": 6,
                    "md": 4
                },
                "allowHistory": {
                    "type": "checkbox",
                    "label": "Allow reading history",
                    "default": true,
                    "sm": 6,
                    "md": 3
                },
                "allowReadLogs": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Allow reading logs",
                    "default": false,
                    "sm": 6,
                    "md": 3
                },
                "allowWriteLogs": {
                    "type": "checkbox",
                    "label": "Allow writing to the log",
                    "default": false,
                    "sm": 6,
                    "md": 3
                },
                "allowFiles": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Allow reading files",
                    "default": false,
                    "sm": 6,
                    "md": 3
                },
                "allowSystemInfo": {
                    "type": "checkbox",
                    "label": "Allow system info (hosts, instances, adapters)",
                    "default": true,
                    "sm": 6,
                    "md": 3
                },
                "allowObjectChange": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Allow changing objects and files (dangerous)",
                    "default": false,
                    "sm": 12,
                    "md": 6
                },
                "systemPrompt": {
                    "newLine": true,
                    "type": "text",
                    "label": "System prompt",
                    "minRows": 4,
                    "sm": 12,
                    "md": 12
                }
            }
        },
        "_devices": {
            "type": "panel",
            "label": "Devices",
            "items": {
                "_deviceAcl": {
                    "type": "custom",
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "ConfigCustomAssistant/Components/DeviceAclComponent",
                    "guiApi": 2,
                    "bundlerType": "module",
                    "sm": 12
                }
            }
        },
        "_triggers": {
            "type": "panel",
            "label": "Triggers",
            "items": {
                "_triggersHeader": {
                    "type": "header",
                    "text": "Proactive triggers",
                    "size": 2
                },
                "_triggersHint": {
                    "type": "staticText",
                    "text": "A trigger watches states or the clock and then speaks, writes a state, or asks you a question and acts on your answer. Switch single triggers off at runtime with triggers.items.<id>.enabled, test one with its fire button, and all of them with triggers.enabled.",
                    "sm": 12
                },
                "triggers": {
                    "type": "table",
                    "label": "Triggers",
                    "help": "Condition as JSON: {\"state\":\"javascript.0.window\",\"value\":true} or {\"time\":\"23:00\",\"days\":[1,2,3,4,5]}; add \"also\"/\"unless\" for extra or blocking conditions, or use a list for alternatives. Say = announcement, Ask = question (needs response rules, JSON: [{\"match\":\"agreement\",\"say\":\"Okay\",\"setState\":{\"id\":\"...\",\"value\":false}}]). Extra actions as JSON: [{\"setState\":{\"id\":\"...\",\"value\":false}}]. Delay waits before acting (90s/30m/5h), cooldown is the minimum gap between two firings in seconds (default 3600).",
                    "sm": 12,
                    "md": 12,
                    "items": [
                        { "type": "text", "attr": "id", "title": "Id", "width": "8%" },
                        { "type": "text", "attr": "name", "title": "Name", "width": "12%" },
                        { "type": "text", "attr": "when", "title": "When (JSON)", "width": "20%" },
                        { "type": "text", "attr": "room", "title": "Room", "width": "8%" },
                        { "type": "text", "attr": "say", "title": "Say", "width": "14%" },
                        { "type": "text", "attr": "ask", "title": "Ask", "width": "14%" },
                        { "type": "text", "attr": "onResponse", "title": "Response rules (JSON)", "width": "10%" },
                        { "type": "text", "attr": "actions", "title": "Extra actions (JSON)", "width": "8%" },
                        { "type": "text", "attr": "delay", "title": "Delay", "width": "3%" },
                        { "type": "number", "attr": "cooldownSec", "title": "Cooldown (s)", "width": "3%", "min": 0 }
                    ]
                },
                "triggerRephrase": {
                    "type": "checkbox",
                    "label": "Let the LLM reword trigger texts",
                    "help": "Before a trigger speaks, the model rewords its text so repeated announcements do not sound canned. Costs one small LLM call per announcement; the original text is used if it fails.",
                    "default": false,
                    "sm": 12,
                    "md": 6
                }
            }
        },
        "_voice": {
            "type": "panel",
            "label": "Voice",
            "items": {
                "_voiceHeader": {
                    "type": "header",
                    "size": 2,
                    "text": "Voice satellites"
                },
                "voiceEnabled": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Enable voice (STT/TTS for satellites)",
                    "help": "Enables speech recognition/synthesis. ioBroker-native satellites reach it over the message bus — no port needed. Turn on the UDP server below only for ESP / Hannah satellites.",
                    "default": false,
                    "sm": 12,
                    "md": 6
                },
                "udpServerEnabled": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Run the UDP voice server (ESP / Hannah satellites)",
                    "help": "Opens a UDP port for streaming microphone satellites (Hannah-compatible / ESP). Not needed for ioBroker-native satellites.",
                    "default": false,
                    "hidden": "!data.voiceEnabled",
                    "sm": 12,
                    "md": 6
                },
                "bind": {
                    "newLine": true,
                    "type": "ip",
                    "freeSolo": true,
                    "label": "Bind address",
                    "help": "Interface the UDP voice server listens on. 0.0.0.0 = all interfaces; pick a specific host IP so satellites on the LAN can reach it.",
                    "default": "0.0.0.0",
                    "listenOnAllPorts": true,
                    "hidden": "!data.voiceEnabled || !data.udpServerEnabled",
                    "sm": 6,
                    "md": 3
                },
                "port": {
                    "type": "number",
                    "label": "UDP port",
                    "default": 7775,
                    "min": 1,
                    "max": 65535,
                    "hidden": "!data.voiceEnabled || !data.udpServerEnabled",
                    "sm": 6,
                    "md": 3
                },
                "wyomingEnabled": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Also accept Wyoming clients (TCP)",
                    "help": "Home Assistant Voice PE / wyoming-satellite / ESPHome voice devices can stream to this adapter over the Wyoming protocol.",
                    "default": false,
                    "hidden": "!data.voiceEnabled",
                    "sm": 8,
                    "md": 5
                },
                "wyomingPort": {
                    "type": "number",
                    "label": "Wyoming TCP port",
                    "default": 10700,
                    "min": 1,
                    "max": 65535,
                    "hidden": "!data.voiceEnabled || !data.wyomingEnabled",
                    "sm": 4,
                    "md": 3
                },
                "esphomeEnabled": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Also drive ESPHome voice satellites",
                    "help": "ThirdReality Voice & Music Assistant, Home Assistant Voice PE, linux-voice-assistant. These devices listen on TCP 6053 and the adapter dials them, so no port is opened for the audio itself — only the media server below, which they fetch the spoken reply from.",
                    "default": false,
                    "hidden": "!data.voiceEnabled",
                    "sm": 12,
                    "md": 6
                },
                "esphomeDevices": {
                    "newLine": true,
                    "type": "table",
                    "label": "ESPHome satellites",
                    "help": "One row per device. Port empty = 6053. The room is what the assistant treats the satellite as being in. Leave the password empty unless the device really has an API password set — table values are stored unencrypted.",
                    "hidden": "!data.voiceEnabled || !data.esphomeEnabled",
                    "sm": 12,
                    "md": 12,
                    "items": [
                        { "type": "text", "attr": "ip", "title": "Address (IP or host name)", "width": "30%" },
                        {
                            "type": "number",
                            "attr": "port",
                            "title": "Port",
                            "width": "15%",
                            "min": 1,
                            "max": 65535,
                            "default": 6053
                        },
                        { "type": "text", "attr": "room", "title": "Room", "width": "30%" },
                        { "type": "text", "attr": "password", "title": "API password (usually empty)", "width": "25%" }
                    ]
                },
                "esphomeMediaPort": {
                    "newLine": true,
                    "type": "number",
                    "label": "Media server port",
                    "help": "ESPHome satellites do not get the reply over their API socket — they fetch it as a URL. This is the port that small HTTP server listens on.",
                    "default": 8099,
                    "min": 1,
                    "max": 65535,
                    "hidden": "!data.voiceEnabled || !data.esphomeEnabled",
                    "sm": 6,
                    "md": 3
                },
                "esphomeMediaHost": {
                    "type": "ip",
                    "freeSolo": true,
                    "label": "Media server address for the devices",
                    "help": "Host the satellites should fetch the audio from. Empty = use the address of each device connection automatically; set it only if the devices reach this machine under a different address (NAT, Docker, VLAN).",
                    "default": "",
                    "hidden": "!data.voiceEnabled || !data.esphomeEnabled",
                    "sm": 6,
                    "md": 4
                },
                "esphomeSilenceMs": {
                    "type": "number",
                    "label": "End of speech after (ms of silence)",
                    "help": "These devices stream until the server stops them, so the adapter decides when you stopped talking. Raise it if replies cut you off, lower it if the assistant waits too long.",
                    "default": 900,
                    "min": 200,
                    "max": 5000,
                    "hidden": "!data.voiceEnabled || !data.esphomeEnabled",
                    "sm": 6,
                    "md": 3
                },
                "voiceLanguage": {
                    "newLine": true,
                    "type": "select",
                    "label": "Voice language",
                    "help": "Language for speech recognition and the spoken reply.",
                    "options": [
                        { "label": "System language", "value": "" },
                        { "label": "Deutsch", "value": "de" },
                        { "label": "English", "value": "en" },
                        { "label": "Русский", "value": "ru" },
                        { "label": "Français", "value": "fr" },
                        { "label": "Italiano", "value": "it" },
                        { "label": "Español", "value": "es" },
                        { "label": "Nederlands", "value": "nl" },
                        { "label": "Polski", "value": "pl" },
                        { "label": "Português", "value": "pt" },
                        { "label": "Українська", "value": "uk" },
                        { "label": "中文", "value": "zh-cn" }
                    ],
                    "default": "",
                    "hidden": "!data.voiceEnabled",
                    "sm": 6,
                    "md": 3
                },
                "announceTargets": {
                    "newLine": true,
                    "type": "table",
                    "label": "Announcement targets (groups and people)",
                    "help": "Give a set of satellites a name, so an announcement, a question or a trigger can address it: a group of rooms (\"Upstairs\") or the speakers that belong to one person (\"Denis\", so \"tell Denis dinner is ready\" reaches them). Members: satellite ids, room names or device names, separated by commas. Kind: empty or group, or person. A real satellite or room of the same name always wins, so a group can never make a speaker unreachable.",
                    "hidden": "!data.voiceEnabled",
                    "sm": 12,
                    "md": 12,
                    "items": [
                        { "type": "text", "attr": "name", "title": "Name", "width": "25%" },
                        {
                            "type": "text",
                            "attr": "members",
                            "title": "Satellites, rooms or devices (comma separated)",
                            "width": "60%"
                        },
                        { "type": "text", "attr": "kind", "title": "Kind (group/person)", "width": "15%" }
                    ]
                },
                "sttProvider": {
                    "newLine": true,
                    "type": "select",
                    "label": "Speech-to-text provider",
                    "options": [
                        { "label": "OpenAI (Whisper)", "value": "openai" },
                        { "label": "Azure Speech", "value": "azure" },
                        { "label": "AWS Transcribe", "value": "aws" },
                        { "label": "Vosk (local)", "value": "vosk" }
                    ],
                    "default": "openai",
                    "hidden": "!data.voiceEnabled",
                    "sm": 6,
                    "md": 3
                },
                "ttsProvider": {
                    "type": "select",
                    "label": "Text-to-speech provider",
                    "options": [
                        { "label": "OpenAI", "value": "openai" },
                        { "label": "Azure Speech", "value": "azure" },
                        { "label": "AWS Polly", "value": "aws" },
                        { "label": "Piper (local)", "value": "piper" }
                    ],
                    "default": "openai",
                    "hidden": "!data.voiceEnabled",
                    "sm": 6,
                    "md": 3
                },
                "sttFallback": {
                    "newLine": true,
                    "type": "select",
                    "label": "Speech-to-text fallback",
                    "help": "Used when the provider above fails (outage, expired key, empty quota). A local engine keeps voice working without the internet.",
                    "options": [
                        { "label": "None", "value": "" },
                        { "label": "OpenAI (Whisper)", "value": "openai" },
                        { "label": "Azure Speech", "value": "azure" },
                        { "label": "AWS Transcribe", "value": "aws" },
                        { "label": "Vosk (local)", "value": "vosk" }
                    ],
                    "default": "",
                    "hidden": "!data.voiceEnabled",
                    "sm": 6,
                    "md": 3
                },
                "ttsFallback": {
                    "type": "select",
                    "label": "Text-to-speech fallback",
                    "help": "Used when the provider above fails. Piper keeps the assistant speaking without the internet.",
                    "options": [
                        { "label": "None", "value": "" },
                        { "label": "OpenAI", "value": "openai" },
                        { "label": "Azure Speech", "value": "azure" },
                        { "label": "AWS Polly", "value": "aws" },
                        { "label": "Piper (local)", "value": "piper" }
                    ],
                    "default": "",
                    "hidden": "!data.voiceEnabled",
                    "sm": 6,
                    "md": 3
                },
                "voiceCredentialType": {
                    "newLine": true,
                    "type": "select",
                    "label": "Speech credential mode",
                    "options": [
                        { "label": "Store keys in adapter", "value": "manual" },
                        { "label": "Central credential store", "value": "manager" }
                    ],
                    "default": "manual",
                    "hidden": "!data.voiceEnabled || (data.sttProvider === 'vosk' && data.ttsProvider === 'piper')",
                    "sm": 12,
                    "md": 4
                },
                "_openaiSpeechHeader": {
                    "newLine": true,
                    "type": "header",
                    "size": 3,
                    "text": "OpenAI speech",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'openai' && data.ttsProvider !== 'openai')"
                },
                "voiceApiKey": {
                    "newLine": true,
                    "type": "password",
                    "label": "OpenAI key for speech (optional)",
                    "help": "Leave empty to reuse the main API key when the LLM provider is OpenAI; required otherwise.",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'openai' && data.ttsProvider !== 'openai') || data.voiceCredentialType === 'manager'",
                    "sm": 12,
                    "md": 8
                },
                "voiceCredentialId": {
                    "newLine": true,
                    "type": "credential",
                    "credentialType": "ai",
                    "label": "OpenAI credential",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'openai' && data.ttsProvider !== 'openai') || data.voiceCredentialType !== 'manager'",
                    "sm": 12,
                    "md": 6
                },
                "ttsVoice": {
                    "newLine": true,
                    "type": "autocompleteSendTo",
                    "command": "getVoices",
                    "jsonData": "{\"ttsProvider\":\"${data.ttsProvider}\",\"language\":\"${data.voiceLanguage}\",\"voiceCredentialType\":\"${data.voiceCredentialType}\",\"voiceApiKey\":\"${data.voiceApiKey}\",\"voiceCredentialId\":\"${data.voiceCredentialId}\"}",
                    "alsoDependsOn": ["ttsProvider", "voiceLanguage", "voiceCredentialType"],
                    "freeSolo": true,
                    "label": "TTS voice",
                    "help": "Loaded from the provider (instance must run); you can also type a voice id.",
                    "default": "alloy",
                    "hidden": "!data.voiceEnabled || data.ttsProvider !== 'openai'",
                    "sm": 6,
                    "md": 4
                },
                "sttModel": {
                    "newLine": true,
                    "type": "text",
                    "label": "OpenAI STT model (optional)",
                    "help": "Empty = whisper-1. Also: gpt-4o-transcribe, gpt-4o-mini-transcribe.",
                    "hidden": "!data.voiceEnabled || data.sttProvider !== 'openai'",
                    "sm": 6,
                    "md": 4
                },
                "ttsModel": {
                    "type": "text",
                    "label": "OpenAI TTS model (optional)",
                    "help": "Empty = tts-1. Also: tts-1-hd, gpt-4o-mini-tts.",
                    "hidden": "!data.voiceEnabled || data.ttsProvider !== 'openai'",
                    "sm": 6,
                    "md": 4
                },
                "_azureSpeechHeader": {
                    "newLine": true,
                    "type": "header",
                    "size": 3,
                    "text": "Azure Speech",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'azure' && data.ttsProvider !== 'azure')"
                },
                "azureSpeechKey": {
                    "newLine": true,
                    "type": "password",
                    "label": "Azure subscription key",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'azure' && data.ttsProvider !== 'azure') || data.voiceCredentialType === 'manager'",
                    "sm": 12,
                    "md": 5
                },
                "azureSpeechRegion": {
                    "type": "text",
                    "label": "Azure region",
                    "help": "e.g. westeurope",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'azure' && data.ttsProvider !== 'azure') || data.voiceCredentialType === 'manager'",
                    "sm": 6,
                    "md": 3
                },
                "azureCredentialId": {
                    "newLine": true,
                    "type": "credential",
                    "credentialType": "azure",
                    "label": "Azure credential",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'azure' && data.ttsProvider !== 'azure') || data.voiceCredentialType !== 'manager'",
                    "sm": 12,
                    "md": 6
                },
                "azureVoice": {
                    "newLine": true,
                    "type": "autocompleteSendTo",
                    "command": "getVoices",
                    "jsonData": "{\"ttsProvider\":\"${data.ttsProvider}\",\"language\":\"${data.voiceLanguage}\",\"voiceCredentialType\":\"${data.voiceCredentialType}\",\"azureSpeechKey\":\"${data.azureSpeechKey}\",\"azureSpeechRegion\":\"${data.azureSpeechRegion}\",\"azureCredentialId\":\"${data.azureCredentialId}\"}",
                    "alsoDependsOn": [
                        "ttsProvider",
                        "voiceLanguage",
                        "voiceCredentialType",
                        "azureSpeechKey",
                        "azureSpeechRegion",
                        "azureCredentialId"
                    ],
                    "freeSolo": true,
                    "label": "Azure voice (optional)",
                    "help": "Loaded from Azure (instance must run); empty = pick by language. e.g. de-DE-KatjaNeural.",
                    "hidden": "!data.voiceEnabled || data.ttsProvider !== 'azure'",
                    "sm": 6,
                    "md": 5
                },
                "_awsSpeechHeader": {
                    "newLine": true,
                    "type": "header",
                    "size": 3,
                    "text": "AWS speech",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'aws' && data.ttsProvider !== 'aws')"
                },
                "awsAccessKeyId": {
                    "newLine": true,
                    "type": "text",
                    "label": "AWS access key id",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'aws' && data.ttsProvider !== 'aws') || data.voiceCredentialType === 'manager'",
                    "sm": 12,
                    "md": 4
                },
                "awsSecretAccessKey": {
                    "type": "password",
                    "label": "AWS secret access key",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'aws' && data.ttsProvider !== 'aws') || data.voiceCredentialType === 'manager'",
                    "sm": 12,
                    "md": 4
                },
                "awsRegion": {
                    "type": "text",
                    "label": "AWS region",
                    "help": "e.g. eu-central-1",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'aws' && data.ttsProvider !== 'aws') || data.voiceCredentialType === 'manager'",
                    "sm": 6,
                    "md": 3
                },
                "awsCredentialId": {
                    "newLine": true,
                    "type": "credential",
                    "credentialType": "aws",
                    "label": "AWS credential",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'aws' && data.ttsProvider !== 'aws') || data.voiceCredentialType !== 'manager'",
                    "sm": 12,
                    "md": 6
                },
                "awsVoice": {
                    "newLine": true,
                    "type": "autocompleteSendTo",
                    "command": "getVoices",
                    "jsonData": "{\"ttsProvider\":\"${data.ttsProvider}\",\"language\":\"${data.voiceLanguage}\",\"voiceCredentialType\":\"${data.voiceCredentialType}\",\"awsAccessKeyId\":\"${data.awsAccessKeyId}\",\"awsSecretAccessKey\":\"${data.awsSecretAccessKey}\",\"awsRegion\":\"${data.awsRegion}\",\"awsCredentialId\":\"${data.awsCredentialId}\"}",
                    "alsoDependsOn": [
                        "ttsProvider",
                        "voiceLanguage",
                        "voiceCredentialType",
                        "awsAccessKeyId",
                        "awsSecretAccessKey",
                        "awsRegion",
                        "awsCredentialId"
                    ],
                    "freeSolo": true,
                    "label": "AWS Polly voice (optional)",
                    "help": "Loaded from Polly (instance must run); empty = default per language. e.g. Vicki, Tatyana.",
                    "hidden": "!data.voiceEnabled || data.ttsProvider !== 'aws'",
                    "sm": 6,
                    "md": 5
                },
                "_localSpeechHeader": {
                    "newLine": true,
                    "type": "header",
                    "size": 3,
                    "text": "Local speech (no cloud)",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'vosk' && data.ttsProvider !== 'piper')"
                },
                "_localSpeechHint": {
                    "newLine": true,
                    "type": "staticText",
                    "text": "Vosk (STT) and Piper (TTS) run on this host. Models and the Piper binary are downloaded automatically on first use (needs internet, plus 'unzip'/'tar'). No API key required.",
                    "hidden": "!data.voiceEnabled || (data.sttProvider !== 'vosk' && data.ttsProvider !== 'piper')",
                    "sm": 12,
                    "md": 12
                },
                "voskModel": {
                    "newLine": true,
                    "type": "autocompleteSendTo",
                    "command": "getSttModels",
                    "jsonData": "{\"sttProvider\":\"${data.sttProvider}\",\"language\":\"${data.voiceLanguage}\"}",
                    "alsoDependsOn": ["sttProvider", "voiceLanguage"],
                    "freeSolo": true,
                    "label": "Vosk model (optional)",
                    "help": "Model name from alphacephei.com/vosk/models, e.g. vosk-model-small-de-0.15. Empty = small default per language.",
                    "hidden": "!data.voiceEnabled || data.sttProvider !== 'vosk'",
                    "sm": 12,
                    "md": 6
                },
                "piperVoice": {
                    "newLine": true,
                    "type": "autocompleteSendTo",
                    "command": "getVoices",
                    "jsonData": "{\"ttsProvider\":\"${data.ttsProvider}\",\"language\":\"${data.voiceLanguage}\"}",
                    "alsoDependsOn": ["ttsProvider", "voiceLanguage"],
                    "freeSolo": true,
                    "label": "Piper voice (optional)",
                    "help": "e.g. de_DE-thorsten-medium, ru_RU-irina-medium. Empty = default per language.",
                    "hidden": "!data.voiceEnabled || data.ttsProvider !== 'piper'",
                    "sm": 6,
                    "md": 5
                }
            }
        },
        "_chat": {
            "type": "panel",
            "label": "Chat",
            "items": {
                "_chatComponent": {
                    "type": "custom",
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "ConfigCustomAssistant/Components/ChatComponent",
                    "guiApi": 2,
                    "bundlerType": "module",
                    "sm": 12
                }
            }
        },
        "_satellites": {
            "type": "panel",
            "label": "Satellites",
            "items": {
                "_satellitesComponent": {
                    "type": "custom",
                    "i18n": true,
                    "url": "custom/customComponents.js",
                    "name": "ConfigCustomAssistant/Components/SatellitesComponent",
                    "guiApi": 2,
                    "bundlerType": "module",
                    "sm": 12
                }
            }
        }
    }
}
