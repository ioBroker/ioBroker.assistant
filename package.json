{
  "name": "iobroker.assistant",
  "version": "0.1.4",
  "description": "LLM assistant for ioBroker — ask about and control any state via an LLM with tool-calling",
  "author": "ioBroker",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "assistant",
    "llm",
    "voice",
    "openai",
    "anthropic"
  ],
  "main": "build/main.js",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.119.0",
    "@aws-sdk/client-polly": "^3.1113.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1113.0",
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/mcp-server": "^1.0.1",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/build-tools": "^3.0.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test:integration": "tsc -p tsconfig.build.json && node --test \"test/integration/*.test.js\"",
    "test:package": "mocha test/testPackageFiles.ts --exit",
    "test": "npm run test:integration",
    "build": "npm run build:backend && npm run build:gui",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:gui": "cd src-admin && npm install && npm run build",
    "lint": "eslint -c eslint.config.mjs",
    "npm": "npm i && cd src-admin && npm i",
    "prepublishOnly": "npm run build",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "release": "release-script",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-admin && npx -y npm-check-updates --upgrade"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.assistant/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.assistant.git"
  },
  "homepage": "https://github.com/ioBroker/ioBroker.assistant",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ]
}
